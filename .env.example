# Postgres (Neon pooled connection string). pg 8.x treats sslmode=require as verify-full and warns; say verify-full explicitly.
DATABASE_URL=postgresql://user:password@host/db?sslmode=verify-full

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Used once by `npm run db:seed` to create the first admin
ADMIN_EMAIL=admin@thehookerlab.co.nz
ADMIN_PASSWORD=change-me-now

# Resend API key. The sender address is set in the admin under Settings and must be on a domain verified in Resend
# (use onboarding@resend.dev while testing; it only delivers to your own Resend account email).
RESEND_API_KEY=

NEXT_PUBLIC_SITE_URL=https://thehookerlab.co.nz
